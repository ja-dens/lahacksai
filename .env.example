# Configuration placeholders only; never put real keys in this tracked file.
# T3 reads model settings from the environment; other modules own Photon/context.
PHOTON_API_KEY=
# Preferred model key. GOOGLE_API_KEY and VISION_API_KEY remain supported aliases.
GEMINI_API_KEY=
GOOGLE_API_KEY=
VISION_API_KEY=
# Recommended default: gemini-3.5-flash-lite. Set explicitly in your ignored .env.
VISION_MODEL=
EXPLANATION_LANGUAGE=en
# Default 25 preceding messages; application overrides must stay within 20-25.
CONTEXT_MESSAGE_LIMIT=25

# Optional Fetch setup; keep actual values in an ignored local .env.
ASI1_API_KEY=
FETCH_AGENT_NAME=
FETCH_AGENT_SEED=
# Real Photon assembly needs verified project/channel/agent configuration.
PHOTON_PROJECT_ID=
PHOTON_AGENT_HANDLE=
# Only this exact sender handle may drive the verified direct-space runtime.
PHOTON_ALLOWED_SENDER=
STICKER_DB_PATH=local-data/live.sqlite3
PHOTON_POLL_SECONDS=2
# Zero reads the current received history on first start. A positive value bounds it.
PHOTON_LOOKBACK_SECONDS=0
PHOTON_TIMEOUT_SECONDS=15
